# 공공데이터포털(data.go.kr)에서 "소상공인시장진흥공단_상가(상권)정보" 활용신청 후 발급받은
# 서비스키를 DATA_GO_KR_SERVICE_KEY 에 넣으세요.
# 마이페이지 > 데이터활용 > Open API > 상가(상권)정보 에서 "일반 인증키(Decoding)" 값을 사용하세요.
DATA_GO_KR_SERVICE_KEY=

# (선택) 조회 중심 좌표/반경 - 비워두면 scripts/fetchStores.js의 기본값(126.680, 37.465, 1000m) 사용.
STORE_CX=
STORE_CY=
STORE_RADIUS=

# 카카오디벨로퍼스(developers.kakao.com) 앱의 JavaScript 키.
# 브라우저에 그대로 노출되는 게 정상인 키라 NEXT_PUBLIC_ 접두사를 붙인다 (도메인 등록으로 보호됨).
# 플랫폼 키 > JavaScript 키 발급 후, 그 키 카드에서 "JS SDK 도메인"에 서비스 도메인을 등록해야 동작한다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 카카오디벨로퍼스 REST API 키. 역 검색(키워드 장소 검색) 같은 서버 전용 호출에 쓴다.
# 절대 NEXT_PUBLIC_ 접두사 붙이지 말 것 — 브라우저에 노출되면 안 되는 키.
KAKAO_REST_API_KEY=
